# Never commit real credentials. Copy to .env.local for local development.
APP_URL=http://localhost:3000
SHOPIFY_SHOP_DOMAIN=dx0nin-1q.myshopify.com
ADMIN_EMAIL=
# Generate with: npm run password:hash
ADMIN_PASSWORD_HASH=
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Vercel production only: connect a PRIVATE Blob store in Storage, then redeploy.
# Use the provider's server environment settings. Never commit the real token.
# Missing/invalid storage fails closed on Vercel; it never falls back to .local.
# Do not copy VERCEL / VERCEL_ENV into local previews.
BLOB_READ_WRITE_TOKEN=
