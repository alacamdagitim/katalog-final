# Never commit real credentials. Copy to .env.local for local development.
APP_URL=http://localhost:3000
DATABASE_URL=file:.local/catalog.db
DATABASE_AUTH_TOKEN=
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHOPIFY_TOKEN_KEY=
# Generate a different random value for scheduler authentication.
CRON_SECRET=
SHOPIFY_SHOP_DOMAIN=dx0nin-1q.myshopify.com
# Set true ONLY in the production deployment with a working scheduler.
SYNC_ENABLED=false
